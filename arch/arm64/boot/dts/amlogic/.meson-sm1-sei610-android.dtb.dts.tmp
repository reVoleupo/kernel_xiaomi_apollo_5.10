# 0 "arch/arm64/boot/dts/amlogic/meson-sm1-sei610-android.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/amlogic/meson-sm1-sei610-android.dts"





/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 10 "arch/arm64/boot/dts/amlogic/meson-sm1-sei610-android.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/meson-g12a-gpio.h" 1
# 11 "arch/arm64/boot/dts/amlogic/meson-sm1-sei610-android.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 1
# 13 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/linux-event-codes.h" 1
# 14 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 2
# 12 "arch/arm64/boot/dts/amlogic/meson-sm1-sei610-android.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 13 "arch/arm64/boot/dts/amlogic/meson-sm1-sei610-android.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/arm-gic.h" 1
# 14 "arch/arm64/boot/dts/amlogic/meson-sm1-sei610-android.dts" 2

/ {
  compatible = "seirobotics,sei610", "amlogic,sm1";
  model = "SEI Robotics SEI610";
  fragment@101 {
 target-path = "/";
 __overlay__ {

  reserved-memory {
   #address-cells = <2>;
   #size-cells = <2>;
   ramoops@d000000 {
    compatible = "ramoops";
    reg = <0x0 0x0d000000 0x0 0x00100000>;
    record-size = <0x8000>;
    console-size = <0x8000>;
    ftrace-size = <0x0>;
    pmsg-size = <0x8000>;
   };
  };
 };
   };
};

&vddao_3v3_t {
 gpio-open-drain;
};

&emmc_pwrseq {
 status = "okay";
};

&sd_emmc_a {

 keep-power-in-suspend;
};

&uart_C {
        status = "disabled";
        pinctrl-0 = <&uart_c_pins>;
        pinctrl-names = "default";
};

&spicc0 {
        status = "disabled";
        pinctrl-names = "default";
        pinctrl-0 = <&spicc0_x_pins>;
        cs-gpios = <&gpio 75 1>;
        #address-cells = <1>;
        #size-cells = <0>;

        spidev@0 {
            compatible = "rohm,dh2228fv";
            reg = <0>;
            spi-max-frequency = <500000>;
            status = "disabled";
        };
};

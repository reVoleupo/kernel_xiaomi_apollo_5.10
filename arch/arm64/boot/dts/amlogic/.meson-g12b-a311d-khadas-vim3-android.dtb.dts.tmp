# 0 "arch/arm64/boot/dts/amlogic/meson-g12b-a311d-khadas-vim3-android.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/amlogic/meson-g12b-a311d-khadas-vim3-android.dts"





/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/phy/phy.h" 1
# 10 "arch/arm64/boot/dts/amlogic/meson-g12b-a311d-khadas-vim3-android.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 11 "arch/arm64/boot/dts/amlogic/meson-g12b-a311d-khadas-vim3-android.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/meson-g12a-gpio.h" 1
# 12 "arch/arm64/boot/dts/amlogic/meson-g12b-a311d-khadas-vim3-android.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 1
# 13 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/linux-event-codes.h" 1
# 14 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 2
# 13 "arch/arm64/boot/dts/amlogic/meson-g12b-a311d-khadas-vim3-android.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 14 "arch/arm64/boot/dts/amlogic/meson-g12b-a311d-khadas-vim3-android.dts" 2

/ {
  compatible = "khadas,vim3", "amlogic,a311d", "amlogic,g12b";
  model = "Khadas VIM3";
  fragment@101 {
        target-path = "/";
        __overlay__ {
                reserved-memory {
                        #address-cells = <2>;
                        #size-cells = <2>;
                        ramoops@d000000 {
                                compatible = "ramoops";
                                reg = <0x0 0x0d000000 0x0 0x00100000>;
                                record-size = <0x8000>;
                                console-size = <0x8000>;
                                ftrace-size = <0x0>;
                                pmsg-size = <0x8000>;
                        };
                };

        };
  };
};

&vcc_5v {
 gpio-open-drain;
};

&uart_C {
        status = "okay";
        pinctrl-0 = <&uart_c_pins>;
        pinctrl-names = "default";
};

&emmc_pwrseq{
 status = "okay";
};

&sd_emmc_a {

    keep-power-in-suspend;
};
